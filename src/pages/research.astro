---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title="Research" sideBarActiveItemID="research">
  <div>
    <div class="text-3xl w-full font-bold mb-5">Research</div>
  </div>

  <HorizontalCard
    title="Anomaly Detection"
    desc="Research focused on exploring and improving anomaly detection methods."
    url="#"
    badge="Status: Research going on"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="ReferGPT: Towards Zero-Shot Referring Multi-Object Tracking"
    desc="Investigating zero-shot approaches for referring multi-object tracking."
    url="#"
    badge="Status: Research going on"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="AI for Sustainable Development"
    desc="Applying AI models and UAV (Unmanned Aerial Vehicle) technology for sustainable development."
    url="#"
    badge="Status: Research going on"
  />
</BaseLayout>
