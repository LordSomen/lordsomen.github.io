    url="/blog/generative-ai-playground"
    badge="GEN AI"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Azure ML"
    img="https://images.unsplash.com/photo-1555949963-aa79dcee981c?q=80&w=1200"
    desc="Detailed overview and implementation of the Azure ML project."
    url="/blog/azure-ml"
    badge="Cloud/MLOps"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Traffic-Analysis"
    img="https://images.unsplash.com/photo-1449824913935-59a10b8d2000?q=80&w=1200"
