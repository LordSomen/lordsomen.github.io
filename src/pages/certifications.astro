---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title="Certifications" sideBarActiveItemID="certifications">
  <div>
    <div class="text-3xl w-full font-bold mb-5">My Certifications</div>
  </div>

  <HorizontalCard
    title="Microsoft Certified: Azure Data Scientist Associate"
    img="https://images.unsplash.com/photo-1555949963-aa79dcee981c?q=80&w=1200"
    desc="Completed: Aug 2025. Validates the ability to build and deploy ML models using the Azure Machine Learning workspace."
    url="/blog/microsoft-certified-azure-data-scientist-associate"
    badge="Azure Data Science"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Machine Learning Engineering for Production (MLOps)"
    img="https://images.unsplash.com/photo-1509228468518-180dd4864904?q=80&w=1200"
    desc="Completed: Jul 2024. Specialization covering MLOps concepts, model deployment in production, and CI/CD for ML."
    url="/blog/machine-learning-engineering-for-production-mlops"
    badge="MLOps"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Generative AI Fundamentals"
    img="https://images.unsplash.com/photo-1677442136019-21780ecad995?q=80&w=1200"
    desc="Completed: Jul 2024. Covers the fundamentals of Generative AI, working with LLMs, and prompt engineering."
    url="/blog/generative-ai-fundamentals"
    badge="Generative AI"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Reinvention with Agentic AI"
    img="https://images.unsplash.com/photo-1677442136019-21780ecad995?q=80&w=1200"
    desc="Completed: Jul 2024. Demonstrates expertise in building and deploying autonomous AI agents that leverage advanced LLMs."
    url="/blog/reinvention-with-agentic-ai"
    badge="Agentic AI"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Problem Solving (Basic)"
    img="https://images.unsplash.com/photo-1518770660439-4636190af475?q=80&w=1200"
    desc="Completed: Jul 2024. Covers fundamental problem-solving skills, data structures, and algorithms."
    url="/blog/problem-solving-basic"
    badge="Problem Solving"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Coursera Specialization 1"
    img="https://images.unsplash.com/photo-1620712943543-bcc4688e7485?q=80&w=1200"
    desc="Completed: Jul 2024. Placeholder page for a completed Coursera specialization in AI/ML."
    url="/blog/coursera-specialization-1"
    badge="Coursera Spec"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Coursera Certificate 1"
    img="https://images.unsplash.com/photo-1555949963-ff9fe0c870eb?q=80&w=1200"
    desc="Completed: Jul 2024. Placeholder page for a completed Coursera certificate course."
    url="/blog/coursera-certificate-1"
    badge="Coursera Cert"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Coursera Verified Course 1"
    img="https://images.unsplash.com/photo-1551288049-bebda4e38f71?q=80&w=1200"
    desc="Completed: Jul 2024. Placeholder page for a completed Coursera verified course."
    url="/blog/coursera-verified-course-1"
    badge="Coursera Course"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Udacity Nanodegree 1"
    img="https://images.unsplash.com/photo-1542751371-adc38448a05e?q=80&w=1200"
    desc="Completed: Jul 2024. Placeholder page for a completed Udacity Nanodegree program."
    url="/blog/udacity-nanodegree-1"
